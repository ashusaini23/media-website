---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Platforms from '../components/Platforms.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import AuditModal from '../components/AuditModal.astro';
---

<Layout
  title="GrovexMedia | Social Media Growth and Management Expert"
  description="We help brands, creators, and category leaders grow and manage their social media through high-impact creator partnerships and full channel management."
>
  <Navigation />

  <main id="main-content">
    <Hero />
    <Services />
    <Platforms />
    <About />
    <Contact />
  </main>

  <Footer />
  <BottomBar />
  <AuditModal />
</Layout>
