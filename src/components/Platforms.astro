---
// Platforms.astro - Service Platforms conforming to DESIGN.md
---

<section id="platforms" class="py-16 sm:py-24 bg-white text-[#171A20] scroll-mt-20">
  <div class="max-w-[1380px] mx-auto px-4 sm:px-6">
    <!-- Header Block -->
    <div class="max-w-[760px] mb-10 sm:mb-16">
      <span class="text-[12px] font-medium tracking-[0.2em] text-[#3E6AE1] uppercase block mb-2">
        Channel Reach
      </span>
      <h2 class="text-[26px] sm:text-[32px] md:text-[40px] font-medium leading-[1.2] text-[#171A20] text-balance">
        Service Platforms We Manage and Scale
      </h2>
      <p class="mt-4 text-[14px] sm:text-[16px] leading-[1.6] text-pretty" style="color:#5C5E62;">
        We run growth strategies built for each major digital platform.
      </p>
    </div>

    <!-- Platform Cards Grid (4 platforms) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">

      <!-- Instagram Card -->
      <div class="relative p-6 sm:p-7 rounded-[14px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background:linear-gradient(145deg,#1a0020 0%,#3d005c 100%);border:1px solid rgba(225,48,108,0.2);">
        <div class="absolute top-0 right-0 w-32 h-32 rounded-full pointer-events-none opacity-20 blur-2xl" style="background:radial-gradient(circle,#c13584 0%,transparent 70%);"></div>
        <div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(225,48,108,0.15);border:1px solid rgba(225,48,108,0.3);">
            <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
              <defs><linearGradient id="igP" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="50%" stop-color="#dc2743"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs>
              <path fill="url(#igP)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <h3 class="text-[17px] font-medium text-white mb-2">Instagram</h3>
          <p class="text-[13px] leading-[1.6]" style="color:rgba(255,255,255,0.6);">Aesthetic visual branding, high-conversion Reels distribution, and audience relationship management.</p>
        </div>
        <div class="mt-5 pt-4 border-t flex items-center justify-between text-[11px] sm:text-[12px]" style="border-color:#EEEEEE;">
          <span style="color:rgba(255,255,255,0.4);">Reels &bull; Stories &bull; Grid</span>
          <span class="font-medium" style="color:#e1306c;">Active Ops</span>
        </div>
      </div>

      <!-- YouTube Card -->
      <div class="relative p-6 sm:p-7 rounded-[14px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background:linear-gradient(145deg,#1a0000 0%,#3d0000 100%);border:1px solid rgba(255,0,0,0.2);">
        <div class="absolute top-0 right-0 w-32 h-32 rounded-full pointer-events-none opacity-20 blur-2xl" style="background:radial-gradient(circle,#FF0000 0%,transparent 70%);"></div>
        <div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(255,0,0,0.15);border:1px solid rgba(255,0,0,0.3);">
            <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true" fill="#FF0000">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <h3 class="text-[17px] font-medium text-white mb-2">YouTube</h3>
          <p class="text-[13px] leading-[1.6]" style="color:rgba(255,255,255,0.6);">Full channel management, viral trend research, high-retention video editing, and high-CTR thumbnails.</p>
        </div>
        <div class="mt-5 pt-4 border-t flex items-center justify-between text-[11px] sm:text-[12px]" style="border-color:#EEEEEE;">
          <span style="color:rgba(255,255,255,0.4);">Long-form &bull; Shorts</span>
          <span class="font-medium" style="color:#FF0000;">Full Ops</span>
        </div>
      </div>

      <!-- Facebook Ads Card -->
      <div class="relative p-6 sm:p-7 rounded-[14px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background:linear-gradient(145deg,#10021f 0%,#0d2d5e 100%);border:1px solid rgba(24,119,242,0.2);">
        <div class="absolute top-0 right-0 w-32 h-32 rounded-full pointer-events-none opacity-20 blur-2xl" style="background:radial-gradient(circle,#1877F2 0%,transparent 70%);"></div>
        <div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(24,119,242,0.15);border:1px solid rgba(24,119,242,0.3);">
            <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true" fill="#1877F2">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <h3 class="text-[17px] font-medium text-white mb-2">Facebook Ads</h3>
          <p class="text-[13px] leading-[1.6]" style="color:rgba(255,255,255,0.6);">High-ROAS paid campaigns, retargeting funnels, lookalike audiences, and daily bid optimisation for maximum ROI.</p>
        </div>
        <div class="mt-5 pt-4 border-t flex items-center justify-between text-[11px] sm:text-[12px]" style="border-color:#EEEEEE;">
          <span style="color:rgba(255,255,255,0.4);">Ads &bull; Retargeting</span>
          <span class="font-medium sm:text-[12px]" style="color:#1877F2;">Virality Boost Sales</span>
        </div>
      </div>

      <!-- Google Business Profile Card -->
      <div class="relative p-6 sm:p-7 rounded-[14px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background:linear-gradient(145deg,#0d1b2a 0%,#0f3460 100%);border:1px solid rgba(66,133,244,0.2);">
        <div class="absolute top-0 right-0 w-32 h-32 rounded-full pointer-events-none opacity-20 blur-2xl" style="background:radial-gradient(circle,#4285F4 0%,transparent 70%);"></div>
        <div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(66,133,244,0.15);border:1px solid rgba(66,133,244,0.3);">
            <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
          <h3 class="text-[17px] font-medium text-white mb-2">Google Business Profile</h3>
          <p class="text-[13px] leading-[1.6]" style="color:rgba(255,255,255,0.6);">Complete GMB optimisation â€” reviews, posts, Q&amp;A, photos, and local SEO to dominate Google Maps and local pack rankings.</p>
        </div>
        <div class="mt-5 pt-4 border-t flex items-center justify-between text-[11px] sm:text-[12px]" style="border-color:#EEEEEE;">
          <span style="color:rgba(255,255,255,0.4);">Maps &bull; Local SEO</span>
          <span class="font-medium" style="color:#4285F4;">Rank #1</span>
        </div>
      </div>

    </div>
  </div>
</section>




