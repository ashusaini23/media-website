---
// RoiCalculator.astro - Interactive Social ROI & Pipeline Engine
---

<section id="roi-calculator" class="py-24 bg-[#F4F4F4] text-[#171A20] scroll-mt-20">
  <div class="max-w-[1380px] mx-auto px-6">
    <!-- Header -->
    <div class="text-center max-w-[800px] mx-auto mb-16">
      <span class="text-[12px] font-medium tracking-[0.2em] text-[#3E6AE1] uppercase block mb-2">
        Growth Engine Model
      </span>
      <h2 class="text-[32px] md:text-[38px] font-medium leading-[1.2] text-[#171A20] text-balance">
        Interactive Social ROI & Pipeline Calculator
      </h2>
      <p class="mt-4 text-[15px] text-[#5C5E62] leading-[1.6] text-pretty">
        Input your growth targets and media parameters to calculate algorithmic reach, expected conversion velocity, and net pipeline yield.
      </p>
    </div>

    <!-- Calculator Container conforming to DESIGN.md clean surfaces -->
    <div class="max-w-[1100px] mx-auto bg-white rounded-[12px] border border-[#EEEEEE] overflow-hidden p-6 sm:p-10 md:p-12">
      <!-- Platform Selector Tabs -->
      <div class="mb-10">
        <label class="block text-[13px] font-medium uppercase tracking-wider text-[#5C5E62] mb-3">
          Select Primary Growth Channel
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" role="radiogroup" aria-label="Platform selection">
          <button
            type="button"
            data-channel="omni"
            class="channel-btn py-2.5 px-4 text-[13px] font-medium rounded-[4px] border border-[#3E6AE1] bg-[#3E6AE1] text-white transition-colors duration-[330ms] focus-visible:ring-2 focus-visible:ring-[#3E6AE1] focus-visible:outline-none cursor-pointer"
            aria-checked="true"
            role="radio"
          >
            Omnichannel (Full Scale)
          </button>
          <button
            type="button"
            data-channel="tiktok"
            class="channel-btn py-2.5 px-4 text-[13px] font-medium rounded-[4px] border border-[#EEEEEE] bg-[#F4F4F4] text-[#393C41] hover:bg-[#EEEEEE] transition-colors duration-[330ms] focus-visible:ring-2 focus-visible:ring-[#3E6AE1] focus-visible:outline-none cursor-pointer"
            aria-checked="false"
            role="radio"
          >
            TikTok & Reels Viral
          </button>
          <button
            type="button"
            data-channel="linkedin"
            class="channel-btn py-2.5 px-4 text-[13px] font-medium rounded-[4px] border border-[#EEEEEE] bg-[#F4F4F4] text-[#393C41] hover:bg-[#EEEEEE] transition-colors duration-[330ms] focus-visible:ring-2 focus-visible:ring-[#3E6AE1] focus-visible:outline-none cursor-pointer"
            aria-checked="false"
            role="radio"
          >
            LinkedIn B2B Pipeline
          </button>
          <button
            type="button"
            data-channel="youtube"
            class="channel-btn py-2.5 px-4 text-[13px] font-medium rounded-[4px] border border-[#EEEEEE] bg-[#F4F4F4] text-[#393C41] hover:bg-[#EEEEEE] transition-colors duration-[330ms] focus-visible:ring-2 focus-visible:ring-[#3E6AE1] focus-visible:outline-none cursor-pointer"
            aria-checked="false"
            role="radio"
          >
            YouTube Media Network
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Sliders Column (7 cols) -->
        <div class="lg:col-span-7 space-y-8">
          <!-- Slider 1: Monthly Ad Spend -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="spend-range" class="text-[14px] font-medium text-[#171A20]">
                Monthly Paid Media Spend:
              </label>
              <span id="spend-val" class="text-[18px] font-medium text-[#3E6AE1] tabular-nums">$25,000</span>
            </div>
            <input
              id="spend-range"
              type="range"
              min="5000"
              max="200000"
              step="5000"
              value="25000"
              class="w-full h-2 bg-[#EEEEEE] rounded-lg appearance-none cursor-pointer accent-[#3E6AE1] focus-visible:ring-2 focus-visible:ring-[#3E6AE1]"
              aria-label="Monthly Paid Media Spend"
            />
            <div class="flex justify-between text-[11px] text-[#8E8E8E] mt-1 tabular-nums">
              <span>$5,000/mo</span>
              <span>$100,000/mo</span>
              <span>$200,000+/mo</span>
            </div>
          </div>

          <!-- Slider 2: Current Organic Reach -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="reach-range" class="text-[14px] font-medium text-[#171A20]">
                Current Monthly Organic Reach:
              </label>
              <span id="reach-val" class="text-[18px] font-medium text-[#3E6AE1] tabular-nums">50,000</span>
            </div>
            <input
              id="reach-range"
              type="range"
              min="10000"
              max="1000000"
              step="10000"
              value="50000"
              class="w-full h-2 bg-[#EEEEEE] rounded-lg appearance-none cursor-pointer accent-[#3E6AE1] focus-visible:ring-2 focus-visible:ring-[#3E6AE1]"
              aria-label="Current Monthly Organic Reach"
            />
            <div class="flex justify-between text-[11px] text-[#8E8E8E] mt-1 tabular-nums">
              <span>10K Views</span>
              <span>500K Views</span>
              <span>1M+ Views</span>
            </div>
          </div>

          <!-- Slider 3: Target Average Customer Value (ACV / AOV) -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="aov-range" class="text-[14px] font-medium text-[#171A20]">
                Average Order / Contract Value (AOV/ACV):
              </label>
              <span id="aov-val" class="text-[18px] font-medium text-[#3E6AE1] tabular-nums">$450</span>
            </div>
            <input
              id="aov-range"
              type="range"
              min="50"
              max="5000"
              step="50"
              value="450"
              class="w-full h-2 bg-[#EEEEEE] rounded-lg appearance-none cursor-pointer accent-[#3E6AE1] focus-visible:ring-2 focus-visible:ring-[#3E6AE1]"
              aria-label="Average Order or Contract Value"
            />
            <div class="flex justify-between text-[11px] text-[#8E8E8E] mt-1 tabular-nums">
              <span>$50</span>
              <span>$2,500</span>
              <span>$5,000+</span>
            </div>
          </div>
        </div>

        <!-- Output Metric Card (5 cols) -->
        <div class="lg:col-span-5 bg-[#171A20] text-white rounded-[8px] p-8 flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-medium uppercase tracking-widest text-[#3E6AE1] block mb-1">
              90-Day Projected Output
            </span>
            <div class="text-[34px] font-medium leading-none text-white tabular-nums mb-1" id="projected-pipeline">
              $98,250
            </div>
            <span class="text-[12px] text-white/60">Estimated Monthly Incremental Revenue</span>

            <div class="border-t border-white/10 my-6 pt-6 space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-[13px] text-white/70">Projected Paid ROAS:</span>
                <span class="text-[16px] font-medium text-white tabular-nums" id="projected-roas">3.93x</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[13px] text-white/70">Combined Monthly Impressions:</span>
                <span class="text-[16px] font-medium text-white tabular-nums" id="projected-impressions">1,420,000</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[13px] text-white/70">Estimated CAC Reduction:</span>
                <span class="text-[16px] font-medium text-emerald-400 tabular-nums" id="projected-cac">-34.8%</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[13px] text-white/70">Monthly Qualified Conversions:</span>
                <span class="text-[16px] font-medium text-white tabular-nums" id="projected-leads">218</span>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <button
              type="button"
              data-open-audit
              class="btn-primary w-full justify-center !h-11 text-[14px]"
            >
              Lock In Strategy & Request Audit
            </button>
            <p class="text-center text-[11px] text-white/50 mt-2">
              Based on aggregated client benchmarks &bull; No obligation
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Real-time calculation logic for ROI engine
  const spendInput = document.getElementById('spend-range') as HTMLInputElement;
  const reachInput = document.getElementById('reach-range') as HTMLInputElement;
  const aovInput = document.getElementById('aov-range') as HTMLInputElement;

  const spendVal = document.getElementById('spend-val');
  const reachVal = document.getElementById('reach-val');
  const aovVal = document.getElementById('aov-val');

  const projectedPipeline = document.getElementById('projected-pipeline');
  const projectedRoas = document.getElementById('projected-roas');
  const projectedImpressions = document.getElementById('projected-impressions');
  const projectedCac = document.getElementById('projected-cac');
  const projectedLeads = document.getElementById('projected-leads');

  const channelButtons = document.querySelectorAll('.channel-btn');
  let currentMultiplier = 1.0;

  channelButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      channelButtons.forEach(b => {
        b.classList.remove('bg-[#3E6AE1]', 'text-white', 'border-[#3E6AE1]');
        b.classList.add('bg-[#F4F4F4]', 'text-[#393C41]', 'border-[#EEEEEE]');
        b.setAttribute('aria-checked', 'false');
      });
      btn.classList.remove('bg-[#F4F4F4]', 'text-[#393C41]', 'border-[#EEEEEE]');
      btn.classList.add('bg-[#3E6AE1]', 'text-white', 'border-[#3E6AE1]');
      btn.setAttribute('aria-checked', 'true');

      const ch = btn.getAttribute('data-channel');
      if (ch === 'omni') currentMultiplier = 1.15;
      else if (ch === 'tiktok') currentMultiplier = 1.05;
      else if (ch === 'linkedin') currentMultiplier = 1.25;
      else currentMultiplier = 0.95;

      calculate();
    });
  });

  function calculate() {
    if (!spendInput || !reachInput || !aovInput) return;

    const spend = parseFloat(spendInput.value) || 25000;
    const reach = parseFloat(reachInput.value) || 50000;
    const aov = parseFloat(aovInput.value) || 450;

    // Display formatted inputs
    if (spendVal) spendVal.textContent = '$' + spend.toLocaleString();
    if (reachVal) reachVal.textContent = reach.toLocaleString();
    if (aovVal) aovVal.textContent = '$' + aov.toLocaleString();

    // Algorithmic projection formulas
    const baseRoas = (3.2 + (Math.log10(spend) * 0.2)) * currentMultiplier;
    const roas = Math.min(Math.max(baseRoas, 2.4), 5.8);
    const revenue = Math.round(spend * roas);
    const totalImpressions = Math.round((spend * 45) + (reach * 2.8 * currentMultiplier));
    const leads = Math.max(1, Math.round(revenue / aov));
    const cacDrop = Math.min(48, Math.round((28 + (roas * 1.8)) * 10) / 10);

    if (projectedPipeline) projectedPipeline.textContent = '$' + revenue.toLocaleString();
    if (projectedRoas) projectedRoas.textContent = roas.toFixed(2) + 'x';
    if (projectedImpressions) projectedImpressions.textContent = totalImpressions.toLocaleString();
    if (projectedCac) projectedCac.textContent = '-' + cacDrop.toFixed(1) + '%';
    if (projectedLeads) projectedLeads.textContent = leads.toLocaleString();
  }

  [spendInput, reachInput, aovInput].forEach(inp => {
    inp?.addEventListener('input', calculate);
  });

  calculate();
</script>
