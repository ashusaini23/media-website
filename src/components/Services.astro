---
// Services.astro - VALENCE 4 Core Services conforming to DESIGN.md
---

<section id="services" class="py-16 sm:py-24 bg-white text-[#171A20] scroll-mt-20">
  <div class="max-w-[1380px] mx-auto px-4 sm:px-6">
    <!-- Header Block -->
    <div class="max-w-[800px] mb-10 sm:mb-16">
      <span class="text-[12px] font-medium tracking-[0.2em] text-[#3E6AE1] uppercase block mb-2">
        Our Core Services
      </span>
      <h2 class="text-[26px] sm:text-[32px] md:text-[40px] font-medium leading-[1.2] text-[#171A20] text-balance">
        High-Impact Growth Campaigns Engineered to Scale
      </h2>
      <p class="mt-4 text-[14px] sm:text-[16px] text-[#5C5E62] leading-[1.6] text-pretty">
        We specialize in expanding your digital authority, dominating search results, and executing complete social media management for brands and creators.
      </p>
    </div>

    <!-- 4 Core Services Grid (2x2 layout with vibrant colored cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-8">
      <!-- Service 1: Google Business Profile -->
      <article class="group relative rounded-[16px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background: linear-gradient(135deg,#0d1b2a 0%,#1b2d4f 55%,#0f3460 100%);">
        <div class="absolute top-0 right-0 w-52 h-52 rounded-full pointer-events-none opacity-25 blur-3xl" style="background:radial-gradient(circle,#4285F4 0%,transparent 70%);"></div>
        <div class="p-7 sm:p-10 flex flex-col flex-1">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <span class="text-[11px] sm:text-[12px] font-medium uppercase tracking-wider px-3 py-1 rounded-[4px] border" style="color:#4285F4;background:rgba(66,133,244,0.12);border-color:rgba(66,133,244,0.3);">Local SEO &amp; Visibility</span>
            <span class="text-[12px] font-mono" style="color:rgba(255,255,255,0.4);">01 // GMB</span>
          </div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(66,133,244,0.15);border:1px solid rgba(66,133,244,0.3);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
          <h3 class="text-[21px] sm:text-[24px] font-medium text-white mb-3">Google Business Profile</h3>
          <p class="text-[13px] sm:text-[14px] leading-[1.65] mb-6" style="color:rgba(255,255,255,0.68);">Dominate local search and Google Maps with a fully optimised Business Profile. We handle setup, keyword-rich descriptions, review management, post scheduling, and performance monitoring to drive calls, visits, and conversions.</p>
          <div class="border-t pt-5 mb-8 space-y-2.5" style="border-color:rgba(255,255,255,0.1);">
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Optimisation:</span>
              <span class="font-medium text-white">Reviews, Posts &amp; Q&amp;A</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Visibility:</span>
              <span class="font-medium text-white">Google Maps &amp; Local Pack</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Reporting:</span>
              <span class="font-medium text-white">Monthly Insights &amp; Analytics</span>
            </div>
          </div>
          <div class="mt-auto pt-2 flex items-center justify-between flex-wrap gap-3">
            <button type="button" data-open-audit data-service="Google Business Profile" class="text-[13px] font-medium px-4 h-9 rounded-[4px] cursor-pointer transition-all duration-[330ms] text-white" style="background:#4285F4;">Optimise My Profile</button>
            <span class="text-[12px] font-medium" style="color:rgba(255,255,255,0.38);">Rank #1 Locally</span>
          </div>
        </div>
      </article>

      <!-- Service 2: Facebook Ads -->
      <article class="group relative rounded-[16px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background: linear-gradient(135deg,#10021f 0%,#1c1150 55%,#0d2d5e 100%);">
        <div class="absolute top-0 right-0 w-52 h-52 rounded-full pointer-events-none opacity-25 blur-3xl" style="background:radial-gradient(circle,#1877F2 0%,transparent 70%);"></div>
        <div class="p-7 sm:p-10 flex flex-col flex-1">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <span class="text-[11px] sm:text-[12px] font-medium uppercase tracking-wider px-3 py-1 rounded-[4px] border" style="color:#58a5f5;background:rgba(24,119,242,0.12);border-color:rgba(24,119,242,0.3);">Paid Social &amp; ROAS</span>
            <span class="text-[12px] font-mono" style="color:rgba(255,255,255,0.4);">02 // META ADS</span>
          </div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(24,119,242,0.15);border:1px solid rgba(24,119,242,0.3);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" fill="#1877F2">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <h3 class="text-[21px] sm:text-[24px] font-medium text-white mb-3">Facebook Ads</h3>
          <p class="text-[13px] sm:text-[14px] leading-[1.65] mb-6" style="color:rgba(255,255,255,0.68);">High-ROAS Facebook &amp; Instagram ad campaigns engineered for maximum revenue. From hyper-targeted audience research, creative strategy and A/B testing to daily bid optimisation and transparent conversion reporting that scales your business fast.</p>
          <div class="border-t pt-5 mb-8 space-y-2.5" style="border-color:rgba(255,255,255,0.1);">
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Campaign Type:</span>
              <span class="font-medium text-white">Conversion &amp; Retargeting Ads</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Audience Quality:</span>
              <span class="font-medium text-white">Laser-Targeted Lookalikes</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Execution:</span>
              <span class="font-medium text-white">Daily Optimisation &amp; KPI Reports</span>
            </div>
          </div>
          <div class="mt-auto pt-2 flex items-center justify-between flex-wrap gap-3">
            <button type="button" data-open-audit data-service="Facebook Ads" class="text-[13px] font-medium px-4 h-9 rounded-[4px] cursor-pointer transition-all duration-[330ms] text-white" style="background:#1877F2;">Launch Ad Campaign</button>
            <span class="text-[12px] font-medium" style="color:rgba(255,255,255,0.38);">Guaranteed ROAS</span>
          </div>
        </div>
      </article>

      <!-- Service 3: Social Media & Instagram Management -->
      <article class="group relative rounded-[16px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background: linear-gradient(135deg,#1a0020 0%,#3d005c 55%,#1a0040 100%);">
        <div class="absolute top-0 right-0 w-52 h-52 rounded-full pointer-events-none opacity-25 blur-3xl" style="background:radial-gradient(circle,#c13584 0%,transparent 70%);"></div>
        <div class="p-7 sm:p-10 flex flex-col flex-1">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <span class="text-[11px] sm:text-[12px] font-medium uppercase tracking-wider px-3 py-1 rounded-[4px] border" style="color:#e1306c;background:rgba(225,48,108,0.12);border-color:rgba(225,48,108,0.3);">Instagram &amp; Brand Curation</span>
            <span class="text-[12px] font-mono" style="color:rgba(255,255,255,0.4);">03 // SOCIAL OPS</span>
          </div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(225,48,108,0.15);border:1px solid rgba(225,48,108,0.3);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true">
              <defs><linearGradient id="igG" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="50%" stop-color="#dc2743"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs>
              <path fill="url(#igG)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <h3 class="text-[21px] sm:text-[24px] font-medium text-white mb-3">Social Media &amp; Instagram Management</h3>
          <p class="text-[13px] sm:text-[14px] leading-[1.65] mb-6" style="color:rgba(255,255,255,0.68);">Our Instagram management service optimizes your brand's visual presence, boosts engagement, and drives compound growth through strategic content creation, hyper-targeted audience acquisition, daily community nurturing, and weekly performance analytics.</p>
          <div class="border-t pt-5 mb-8 space-y-2.5" style="border-color:rgba(255,255,255,0.1);">
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Content Strategy:</span>
              <span class="font-medium text-white">High-Retention Reels &amp; Carousels</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Audience Growth:</span>
              <span class="font-medium text-white">Organic Discovery &amp; Niche Targeting</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Reporting:</span>
              <span class="font-medium text-white">Weekly KPI &amp; Conversion Telemetry</span>
            </div>
          </div>
          <div class="mt-auto pt-2 flex items-center justify-between flex-wrap gap-3">
            <button type="button" data-open-audit data-service="Social Media Management" class="text-[13px] font-medium px-4 h-9 rounded-[4px] cursor-pointer transition-all duration-[330ms] text-white" style="background:linear-gradient(90deg,#f09433,#dc2743,#bc1888);">Start Instagram Management</button>
            <span class="text-[12px] font-medium" style="color:rgba(255,255,255,0.38);">Daily Active Ops</span>
          </div>
        </div>
      </article>

      <!-- Service 4: 100% YouTube Management -->
      <article class="group relative rounded-[16px] overflow-hidden flex flex-col justify-between transition-transform duration-[330ms] hover:-translate-y-1" style="background: linear-gradient(135deg,#1a0000 0%,#3d0000 55%,#1a1500 100%);">
        <div class="absolute top-0 right-0 w-52 h-52 rounded-full pointer-events-none opacity-25 blur-3xl" style="background:radial-gradient(circle,#FF0000 0%,transparent 70%);"></div>
        <div class="p-7 sm:p-10 flex flex-col flex-1">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <span class="text-[11px] sm:text-[12px] font-medium uppercase tracking-wider px-3 py-1 rounded-[4px] border" style="color:#ff5555;background:rgba(255,0,0,0.12);border-color:rgba(255,0,0,0.3);">Complete Production</span>
            <span class="text-[12px] font-mono" style="color:rgba(255,255,255,0.4);">04 // YOUTUBE</span>
          </div>
          <div class="w-11 h-11 rounded-[10px] flex items-center justify-center mb-5" style="background:rgba(255,0,0,0.15);border:1px solid rgba(255,0,0,0.3);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" fill="#FF0000">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <h3 class="text-[21px] sm:text-[24px] font-medium text-white mb-3">100% YouTube Management</h3>
          <p class="text-[13px] sm:text-[14px] leading-[1.65] mb-6" style="color:rgba(255,255,255,0.68);">We cover everything end-to-end: researching viral content concepts, scripting, professional retention-driven editing, designing super high-CTR custom thumbnails, SEO tag architecture, and publishing — fully hands-free or tailored to your vision.</p>
          <div class="border-t pt-5 mb-8 space-y-2.5" style="border-color:rgba(255,255,255,0.1);">
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Production Scope:</span>
              <span class="font-medium text-white">Idea &rarr; Script &rarr; Edit &rarr; Upload</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Thumbnails:</span>
              <span class="font-medium text-white">A/B Tested High-CTR Graphics</span>
            </div>
            <div class="flex items-center justify-between text-[12px] sm:text-[13px]">
              <span style="color:rgba(255,255,255,0.48);">Algorithmic Growth:</span>
              <span class="font-medium text-white">Retention &amp; CTR Optimization</span>
            </div>
          </div>
          <div class="mt-auto pt-2 flex items-center justify-between flex-wrap gap-3">
            <button type="button" data-open-audit data-service="100% YouTube Management" class="text-[13px] font-medium px-4 h-9 rounded-[4px] cursor-pointer transition-all duration-[330ms] text-white" style="background:#FF0000;">Launch YouTube Management</button>
            <span class="text-[12px] font-medium" style="color:rgba(255,255,255,0.38);">100% Hands-Free</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
